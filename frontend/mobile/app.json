{
  "expo": {
    "name": "חקלאי רווחי",
    "slug": "yevul",
    "version": "0.0.1",
    "scheme": "yevul",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "supportsRtl": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yevul.app"
    },
    "android": {
      "package": "com.yevul.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה זקוקה לגישה לגלריה כדי לצרף קבלות",
          "cameraPermission": "האפליקציה זקוקה לגישה למצלמה כדי לצלם קבלות"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "האפליקציה זקוקה לגישה למיקרופון כדי לרשום הוצאות, משימות ויומן בקול"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
