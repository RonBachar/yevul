# משתני הסביבה של Supabase המקומי. הקובץ הזה הוא תבנית בלבד, בלי ערכים.
# להעתיק ל-backend/supabase/.env ולמלא. הקובץ .env לא נכנס ל-git.
#
# config.toml מושך את הערכים האלה דרך env(...), ובלעדיהם ספקי הכניסה
# פשוט לא יעבדו, בלי הודעת שגיאה ברורה. ראה docs/env.md.
#
# **כל פקודת supabase רצה מתוך backend, לא משורש הפרויקט.** משורש
# הפרויקט ה-CLI לא מוצא את config.toml ומרים ברירות מחדל בשקט.

# כניסה עם גוגל. נוצרים ב-Google Cloud Console, OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# כניסה עם אפל. דורש חשבון Apple Developer בתשלום, טרם נרכש.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
